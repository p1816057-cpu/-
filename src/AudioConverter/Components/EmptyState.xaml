<UserControl x:Class="AudioConverter.Components.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="56" Height="56"
                Background="{StaticResource Brush.SurfaceAlt}"
                CornerRadius="28"
                HorizontalAlignment="Center">
            <TextBlock Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="26"
                       FontFamily="Segoe UI Symbol"
                       Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource BodyText}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource MetaText}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
