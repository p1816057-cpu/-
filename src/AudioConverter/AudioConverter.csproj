<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AudioConverter</RootNamespace>
    <AssemblyName>SkyFusion</AssemblyName>
    <AssemblyTitle>天融 SkyFusion</AssemblyTitle>
    <Product>天融 SkyFusion</Product>
    <Company>天融</Company>
    <Description>离线全能格式转换工具 · Fuse Anything, Convert Anything</Description>
    <Version>1.0.3.0</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <InformationalVersion>1.0.3</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <!-- 发布时把 FFmpeg/FFprobe 一并复制到 EXE 同级 ffmpeg\bin -->
  <ItemGroup>
    <None Include="..\..\tools\ffmpeg\bin\ffmpeg.exe"
          Link="ffmpeg\bin\ffmpeg.exe"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\ffmpeg\bin\ffmpeg.exe')"/>
    <None Include="..\..\tools\ffmpeg\bin\ffprobe.exe"
          Link="ffmpeg\bin\ffprobe.exe"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\ffmpeg\bin\ffprobe.exe')"/>
  </ItemGroup>

</Project>
