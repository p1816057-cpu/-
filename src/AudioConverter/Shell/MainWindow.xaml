<Window x:Class="AudioConverter.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysshell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="天融 - SkyFusion"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <Geometry x:Key="Geo.Min">M4,7 L12,7</Geometry>
        <Geometry x:Key="Geo.Max">M4,3 L12,3 L12,11 L4,11 Z</Geometry>
        <Geometry x:Key="Geo.Close">M4,4 L12,12 M12,4 L4,12</Geometry>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="sysshell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarMenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="sysshell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E4E8EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <sysshell:WindowChrome.WindowChrome>
        <sysshell:WindowChrome CaptionHeight="38"
                               ResizeBorderThickness="6"
                               GlassFrameThickness="1"
                               CornerRadius="12"
                               UseAeroCaptionButtons="False"/>
    </sysshell:WindowChrome.WindowChrome>

    <DockPanel>
        <!-- 自定义标题栏 -->
        <Border DockPanel.Dock="Top"
                Height="38"
                Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.Divider}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnCaptionMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <Border Width="22" Height="22"
                            Background="{StaticResource Brush.Accent}"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#x266A;"
                                   FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"/>
                    </Border>
                    <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="FileMenuButton"
                                Content="文件"
                                Style="{StaticResource TitleBarMenuButton}"
                                Click="OnFileMenuButtonClick"
                                AutomationProperties.Name="文件"/>
                        <Popup x:Name="FileMenuPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=FileMenuButton}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Style="{StaticResource MenuCard}"
                                    MinWidth="200"
                                    Margin="0,4,0,0"
                                    sysshell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      BlurRadius="16"
                                                      ShadowDepth="1"
                                                      Opacity="0.10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="ImportMenuButton"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnImportMenuButtonClick"
                                            MouseEnter="OnImportMenuMouseEnter"
                                            MouseLeave="OnImportMenuMouseLeave"
                                            AutomationProperties.Name="导入">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="导入" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="›"
                                                       FontSize="14"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button Content="关闭软件"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnCloseClick"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="ImportSubPopup"
                               Placement="Right"
                               PlacementTarget="{Binding ElementName=ImportMenuButton}"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               PopupAnimation="Fade">
                            <Border x:Name="ImportSubCard"
                                    Style="{StaticResource MenuCard}"
                                    MinWidth="190"
                                    Margin="4,0,0,0"
                                    MouseEnter="OnImportSubMenuMouseEnter"
                                    MouseLeave="OnImportSubMenuMouseLeave"
                                    sysshell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      BlurRadius="16"
                                                      ShadowDepth="1"
                                                      Opacity="0.10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="音频 / 视频"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnOpenAudioFileClick"/>
                                    <Button Content="图片"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnOpenImageFileClick"/>
                                    <Button Content="Word / Excel 等"
                                            Style="{StaticResource MenuRowButton}"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Margin="4,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="HelpMenuButton"
                                Content="帮助"
                                Style="{StaticResource TitleBarMenuButton}"
                                Click="OnHelpMenuButtonClick"
                                AutomationProperties.Name="帮助"/>
                        <Popup x:Name="HelpMenuPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=HelpMenuButton}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Style="{StaticResource MenuCard}"
                                    MinWidth="200"
                                    Margin="0,4,0,0"
                                    sysshell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      BlurRadius="16"
                                                      ShadowDepth="1"
                                                      Opacity="0.10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="文档"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnDocsClick"/>
                                    <Button Style="{StaticResource MenuRowButton}"
                                            Click="OnCurrentVersionClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="当前版本" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="v1.1.0"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button Content="关于 天融 - SkyFusion"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnAboutClick"/>
                                    <Button Content="遇到问题了？导出当前日志"
                                            Style="{StaticResource MenuRowButton}"
                                            Click="OnExportLogsClick"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}"
                            AutomationProperties.Name="最小化"
                            Click="OnMinimizeClick"
                            ToolTip="最小化">
                        <Path Data="{StaticResource Geo.Min}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              Width="11"
                              Height="10"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MaxButton"
                            Style="{StaticResource TitleBarButton}"
                            AutomationProperties.Name="最大化"
                            Click="OnMaximizeClick"
                            ToolTip="最大化 / 还原">
                        <Path Data="{StaticResource Geo.Max}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"
                              Width="11"
                              Height="10"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarButton}"
                            AutomationProperties.Name="关闭"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <Path Data="{StaticResource Geo.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              Width="11"
                              Height="10"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：Sidebar + Workspace -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="226"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="导航"
                               FontSize="13"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="24,22,16,4"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Border Height="1"
                                Background="{StaticResource Brush.Border}"
                                Margin="16,4,16,8"/>
                        <ListBox ItemsSource="{Binding BottomItems}"
                                 SelectedItem="{Binding SelectedBottomItem, Mode=TwoWay}"
                                 Style="{StaticResource NavListBox}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding TopItems}"
                             SelectedItem="{Binding SelectedTopItem, Mode=TwoWay}"
                             Style="{StaticResource NavListBox}"
                             Margin="0,0,0,10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Column="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False"/>
        </Grid>
    </DockPanel>
</Window>
