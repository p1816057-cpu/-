<Window x:Class="AudioConverter.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysshell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="天融 - SkyFusion"
        Width="1180"
        Height="720"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <Geometry x:Key="Geo.Min">M4,7 L12,7</Geometry>
        <Geometry x:Key="Geo.Max">M4,3 L12,3 L12,11 L4,11 Z</Geometry>
        <Geometry x:Key="Geo.Close">M4,4 L12,12 M12,4 L4,12</Geometry>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="sysshell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <sysshell:WindowChrome.WindowChrome>
        <sysshell:WindowChrome CaptionHeight="38"
                               ResizeBorderThickness="6"
                               GlassFrameThickness="0"
                               CornerRadius="0"
                               UseAeroCaptionButtons="False"/>
    </sysshell:WindowChrome.WindowChrome>

    <DockPanel>
        <!-- 自定义标题栏 -->
        <Border DockPanel.Dock="Top"
                Height="38"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Divider}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnCaptionMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <Border Width="22" Height="22"
                            Background="{StaticResource Brush.Accent}"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#x266A;"
                                   FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"/>
                    </Border>
                    <TextBlock Text="天融 - SkyFusion"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock Text="v1.0.3"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="8,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}"
                            AutomationProperties.Name="最小化"
                            Click="OnMinimizeClick"
                            ToolTip="最小化">
                        <Path Data="{StaticResource Geo.Min}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              Width="16"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MaxButton"
                            Style="{StaticResource TitleBarButton}"
                            AutomationProperties.Name="最大化"
                            Click="OnMaximizeClick"
                            ToolTip="最大化 / 还原">
                        <Path Data="{StaticResource Geo.Max}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarButton}"
                            AutomationProperties.Name="关闭"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <Path Data="{StaticResource Geo.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：Sidebar + Workspace -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    Background="{StaticResource Brush.AccentSoft}"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x266A;"
                                           FontSize="15"
                                           Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Symbol"/>
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="天融 SkyFusion"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="离线格式转换工具"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Border Height="1"
                                Background="{StaticResource Brush.Border}"
                                Margin="16,4,16,8"/>
                        <ListBox ItemsSource="{Binding BottomItems}"
                                 SelectedItem="{Binding SelectedBottomItem, Mode=TwoWay}"
                                 Style="{StaticResource NavListBox}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding TopItems}"
                             SelectedItem="{Binding SelectedTopItem, Mode=TwoWay}"
                             Style="{StaticResource NavListBox}"
                             Margin="0,0,0,10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Column="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False"/>
        </Grid>
    </DockPanel>
</Window>
