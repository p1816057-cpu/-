<UserControl x:Class="AudioConverter.Modules.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="关于"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="天融 SkyFusion · 离线全能格式转换工具"
                       Style="{StaticResource BodyText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：标识卡 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="72" Height="72"
                            Background="{StaticResource Brush.AccentSoft}"
                            CornerRadius="18"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#x266A;"
                                   FontSize="36"
                                   Foreground="{StaticResource Brush.Accent}"
                                   FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="天融 - SkyFusion"
                               FontSize="17"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding AppVersion}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <Border Background="{StaticResource Brush.AccentSoft}"
                            CornerRadius="8"
                            Padding="10,7"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SloganChinese}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SloganEnglish}"
                                       Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右侧：信息与链接 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="产品信息"
                                   Style="{StaticResource CardTitle}"/>
                        <Button Content="GitHub 仓库 ↗"
                                Style="{StaticResource Button.Ghost}"
                                Foreground="{StaticResource Brush.Accent}"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenGitHubCommand}"
                                ToolTip="仓库链接将在上架 GitHub 后填写"/>
                    </Grid>

                    <Border Height="1"
                            Background="{StaticResource Brush.Divider}"/>

                    <StackPanel Margin="0,14,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="软件名称"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="天融 SkyFusion"
                                       Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AppVersion}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FFmpeg"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FfmpegVersion}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="支持系统"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CompatibilityText}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版权"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CopyrightText}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MetaText}"
                               Text="Powered by FFmpeg（GPL）"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
