<UserControl x:Class="AudioConverter.Modules.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="关于"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="天融 SkyFusion · 离线全能格式转换工具"
                       Style="{StaticResource BodyText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <!-- 产品 Logo：与程序图标同源（Assets/app-logo.png） -->
                            <Image Width="40"
                                   Height="40"
                                   Source="/Assets/app-logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="产品信息"
                                           Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="天融 SkyFusion · 离线全能格式转换工具"
                                           Style="{StaticResource MetaText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="GitHub 仓库 ↗"
                                Style="{StaticResource Button.Ghost}"
                                Foreground="{StaticResource Brush.Accent}"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenGitHubCommand}"
                                ToolTip="仓库链接将在上架 GitHub 后填写"/>
                    </Grid>

                    <Border Height="1"
                            Background="{StaticResource Brush.Divider}"/>

                    <StackPanel Margin="0,14,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="软件名称"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="天融 SkyFusion"
                                       Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AppVersion}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FFmpeg"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FfmpegVersion}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="支持系统"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CompatibilityText}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版权"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CopyrightText}"
                                       Style="{StaticResource BodyText}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MetaText}"
                               Text="Powered by FFmpeg（GPL）"
                               Margin="0,14,0,0"/>
                    <Button Content="遇到问题了？导出日志并联系管理员"
                            Style="{StaticResource Button.Ghost}"
                            Foreground="{StaticResource Brush.Accent}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Command="{Binding ExportLogCommand}"/>
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
