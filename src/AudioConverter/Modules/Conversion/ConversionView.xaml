<UserControl x:Class="AudioConverter.Modules.Conversion.ConversionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:AudioConverter.Components"
             xmlns:conv="clr-namespace:AudioConverter.Modules.Conversion"
             AllowDrop="True"
             PreviewDragOver="OnDragOver"
             Drop="OnDrop">

    <UserControl.Resources>
        <Geometry x:Key="UploadArrow">M8,1.5 L8,10 M4.5,5.5 L8,1.5 L11.5,5.5 M2.5,12.5 L13.5,12.5</Geometry>

        <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type conv:FileItemViewModel}">
            <Border BorderBrush="{StaticResource Brush.Divider}"
                    BorderThickness="0,0,0,1"
                    Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip="选择此文件"/>

                    <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FilePath}"
                                   Style="{StaticResource MetaText}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   ToolTip="{Binding FilePath}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Border Style="{StaticResource Chip}"
                                Background="{Binding Format, Converter={StaticResource FormatToBrush}}">
                            <TextBlock Text="{Binding Format}"
                                       Style="{StaticResource MetaText}"
                                       Foreground="{Binding Format, Converter={StaticResource FormatToForeground}}"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource Chip}"
                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                                Background="{Binding Format, Converter={StaticResource FormatToBrush}}">
                            <TextBlock Text="音轨"
                                       Style="{StaticResource MetaText}"
                                       Foreground="{Binding Format, Converter={StaticResource FormatToForeground}}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToForeground}}"/>
                        <TextBlock Text="{Binding SizeText}"
                                   Style="{StaticResource MetaText}"
                                   Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding DurationText}"
                                   Style="{StaticResource MetaText}"
                                   Margin="0,1,0,0"/>
                        <ProgressBar x:Name="RowProgress"
                                     Value="{Binding Progress}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,3,0,0"
                                     Visibility="Collapsed"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="&#x2715;"
                            Style="{StaticResource Button.Ghost}"
                            Padding="5"
                            FontSize="11"
                            ToolTip="从列表移除"
                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter TargetName="RowProgress" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="DropOverlayButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="音频转换"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="添加音频或视频文件，统一输出为 MP3 / WAV / FLAC"
                       Style="{StaticResource BodyText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- v1.0.1 工作区布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左列：上传 + 文件列表 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上传板块 -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                    <Border x:Name="DropArea"
                            VerticalAlignment="Stretch"
                            MinHeight="120"
                            Background="#FAFAFA"
                            BorderBrush="{StaticResource Brush.BorderStrong}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Cursor="Hand">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <Border Width="64" Height="64"
                                        Background="{StaticResource Brush.AccentSoft}"
                                        CornerRadius="32"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="30" Height="30">
                                        <Path Data="{StaticResource UploadArrow}"
                                              Stroke="{StaticResource Brush.Accent}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="将文件拖到这里，或点击此区域添加"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="支持 MP3 / WAV / FLAC / MP4 / MKV；拖入视频将自动提取音轨"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="24,6,24,0"/>
                                <Border Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,7"
                                        HorizontalAlignment="Center"
                                        Margin="0,14,0,0">
                                    <TextBlock Text="点击添加文件"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <Button Style="{StaticResource DropOverlayButton}"
                                    AutomationProperties.Name="添加文件"
                                    Command="{Binding AddFilesCommand}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 文件列表板块 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource Brush.Divider}"
                                BorderThickness="0,0,0,1"
                                Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <components:TriStateCheckBox IsChecked="{Binding SelectAllState, Mode=TwoWay}"
                                                             Content="全选"
                                                             FontSize="12"
                                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SummaryText}"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                                <Button Grid.Column="2"
                                        Content="清空列表"
                                        Style="{StaticResource Button.Ghost}"
                                        FontSize="12"
                                        Command="{Binding ClearAllCommand}"/>
                            </Grid>
                        </Border>

                        <!-- 空状态 / 文件行 -->
                        <Grid Grid.Row="1">
                            <components:EmptyState Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                                   Title="还没有添加文件"
                                                   Description="拖入文件，或点击「添加文件」"
                                                   Glyph="&#x266A;"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource FileRowTemplate}"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- 运行状态条 -->
                        <Border Grid.Row="2"
                                Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource Brush.AccentSoft}"
                                BorderBrush="{StaticResource Brush.Divider}"
                                BorderThickness="0,1,0,0"
                                Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="正在转换"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActiveTaskName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0"
                                           VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="2"
                                             Value="{Binding ActiveProgress, Mode=OneWay}"
                                             Maximum="100"
                                             Width="120"
                                             Margin="8,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ActiveProgress, StringFormat={}{0:0}%}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Accent}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding ActiveSpeedText, StringFormat=速度 {0}}"
                                           FontSize="12"
                                           Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Button Grid.Column="5"
                                        Content="取消"
                                        Style="{StaticResource Button.Danger}"
                                        Padding="10,4"
                                        FontSize="12"
                                        Command="{Binding CancelCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 右列：转换控制 + 格式参数 + 当前任务 ============ -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 转换控制板块 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="输出格式" Style="{StaticResource SectionLabel}"/>
                        <ComboBox ItemsSource="{Binding OutputFormatOptions}"
                                  SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Text="输出目录"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectoryDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     MaxLines="2"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{Binding OutputDirectoryDisplay}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Background" Value="#FAFAFA"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Content="浏览…"
                                    Style="{StaticResource Button.Secondary}"
                                    Padding="12,6"
                                    FontSize="12"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseOutputCommand}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MetaText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="默认输出到程序所在文件夹的「转换输出」子文件夹；点「浏览…」可改为固定文件夹并保存在本机。"/>
                        <Button Content="改回程序所在文件夹"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12"
                                Padding="6,3"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsCustomOutputDirectory, Converter={StaticResource BoolToVis}}"
                                Command="{Binding UseDefaultOutputCommand}"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="添加文件"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding AddFilesCommand}"/>
                            <Button Grid.Column="2"
                                    Content="{Binding StartButtonText}"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding StartCommand}"/>
                        </Grid>
                        <TextBlock Text="未选择文件时点击开始，将提示「请至少选择一个文件」"
                                   Style="{StaticResource MetaText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 码率格式板块 -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="格式参数"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource Brush.AccentSoft}"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedFormatName}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="{Binding SelectedFormatSummary}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Accent}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource CaptionText}"
                                           Text="固定编码参数，避免手动输入 FFmpeg 参数造成失败。"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="MP3 · 320 kbps CBR"
                                       Style="{StaticResource MetaText}"/>
                            <TextBlock Text="WAV · 16-bit PCM"
                                       Style="{StaticResource MetaText}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="FLAC · Compression Level 5"
                                       Style="{StaticResource MetaText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 转换状态板块 -->
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="转换状态"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,10,0,0">
                            <Grid>
                                <!-- 运行中状态 -->
                                <StackPanel Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="正在转换"
                                               Style="{StaticResource MetaText}"
                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding ActiveTaskName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding ActiveProgress, Mode=OneWay}"
                                                 Maximum="100"
                                                 Margin="0,8,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding ActiveProgress, StringFormat={}{0:0}%}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Accent}"/>
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding ActiveSpeedText, StringFormat=速度 {0}}"
                                                   Style="{StaticResource MetaText}"/>
                                    </Grid>
                                    <Button Content="取消任务"
                                            Style="{StaticResource Button.Danger}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Command="{Binding CancelCommand}"/>
                                </StackPanel>

                                <!-- 空闲状态 -->
                                <StackPanel Visibility="{Binding IsTaskRunning, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="暂无运行任务"
                                               Style="{StaticResource BodyText}"/>
                                    <TextBlock Text="选择文件并点击「开始转换」后，此处将显示进度与速度。"
                                               Style="{StaticResource MetaText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
