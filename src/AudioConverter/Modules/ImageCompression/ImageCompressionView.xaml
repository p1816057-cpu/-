<UserControl x:Class="AudioConverter.Modules.ImageCompression.ImageCompressionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:AudioConverter.Components"
             xmlns:img="clr-namespace:AudioConverter.Modules.ImageCompression"
             AllowDrop="True"
             PreviewDragOver="OnDragOver"
             Drop="OnDrop">

    <UserControl.Resources>
        <Geometry x:Key="ImageUploadArrow">M8,1.5 L8,10 M4.5,5.5 L8,1.5 L11.5,5.5 M2.5,12.5 L13.5,12.5</Geometry>

        <DataTemplate x:Key="ImageCard" DataType="{x:Type img:ImageItemViewModel}">
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource MetaText}"
                                       Text="{Binding DimensionsText, StringFormat=尺寸：{0}}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Format}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding SizeText}"
                                       Style="{StaticResource MetaText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,8,0"/>
                            <Button Content="&#x2715;"
                                    Style="{StaticResource Button.Ghost}"
                                    Padding="5"
                                    FontSize="11"
                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="原图"
                                       Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold"/>
                            <Border Background="#FAFAFA"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,6,0,0"
                                    Padding="6">
                                <Image Source="{Binding FilePath, Converter={StaticResource PathToImage}}"
                                       MaxHeight="240"
                                       Stretch="Uniform"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="压缩后预览"
                                       Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold"/>
                            <Border Background="#FAFAFA"
                                    BorderBrush="{StaticResource Brush.AccentSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,6,0,0"
                                    Padding="6">
                                <Grid>
                                    <Image Source="{Binding PreviewPath, Converter={StaticResource PathToImage}}"
                                           MaxHeight="240"
                                           Stretch="Uniform"/>
                                    <TextBlock Text="{Binding PreviewMessage}"
                                               Style="{StaticResource MetaText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsPreviewing, Converter={StaticResource InverseBool}}"
                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="120"
                                                 Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding CompareResultText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource Brush.Accent}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToForeground}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="DropOverlayButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="图片压缩"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="支持 JPG / PNG / WebP / BMP，压缩前后实时对比"
                       Style="{StaticResource BodyText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ImageLeftGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上半部分：整块上传区域 -->
                <Border x:Name="DropArea"
                        Grid.Row="0"
                        Style="{StaticResource Card}"
                        Padding="12">
                    <Border Background="#FAFAFA"
                            BorderBrush="{StaticResource Brush.BorderStrong}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Cursor="Hand">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <Border Width="68" Height="68"
                                        Background="{StaticResource Brush.AccentSoft}"
                                        CornerRadius="34"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32">
                                        <Path Data="{StaticResource ImageUploadArrow}"
                                              Stroke="{StaticResource Brush.Accent}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="将图片拖到这里，或点击此区域添加"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="支持 JPG / JPEG / PNG / WebP / BMP"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                        Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                                <Border Width="38" Height="38"
                                        Background="{StaticResource Brush.AccentSoft}"
                                        CornerRadius="19"
                                        VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource ImageUploadArrow}"
                                              Stroke="{StaticResource Brush.Accent}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="可继续添加图片"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="点击此区域或直接拖入新图片"
                                               Style="{StaticResource MetaText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Style="{StaticResource DropOverlayButton}"
                                    AutomationProperties.Name="添加图片"
                                    Command="{Binding AddFilesCommand}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 下半部分：对比列表 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Style="{StaticResource Card}"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <components:TriStateCheckBox IsChecked="{Binding SelectAllState, Mode=TwoWay}"
                                                         Content="全选"
                                                         FontSize="12"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SummaryText}"
                                       Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                            <Button Grid.Column="2"
                                    Content="继续添加"
                                    Style="{StaticResource Button.Secondary}"
                                    Padding="10,5"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddFilesCommand}"/>
                            <Button Grid.Column="3"
                                    Content="清空"
                                    Style="{StaticResource Button.Ghost}"
                                    FontSize="12"
                                    Command="{Binding ClearAllCommand}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <components:EmptyState Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                               Title="还没有添加文件"
                                               Description="拖入文件，或点击「添加文件」"
                                               Glyph="&#x274F;"/>

                        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="&#x2039;"
                                    Style="{StaticResource Button.Secondary}"
                                    FontSize="22"
                                    Padding="8,10"
                                    VerticalAlignment="Center"
                                    Click="OnPreviousClick"
                                    IsEnabled="{Binding HasPrevious}"/>

                            <Border Grid.Column="1" Margin="10,0">
                                <ContentControl x:Name="PreviewHost"
                                                Content="{Binding CurrentItem}"
                                                ContentTemplate="{StaticResource ImageCard}">
                                    <ContentControl.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </ContentControl.RenderTransform>
                                </ContentControl>
                            </Border>

                            <Button Grid.Column="2"
                                    Content="&#x203A;"
                                    Style="{StaticResource Button.Secondary}"
                                    FontSize="22"
                                    Padding="8,10"
                                    VerticalAlignment="Center"
                                    Click="OnNextClick"
                                    IsEnabled="{Binding HasNext}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="输出格式" Style="{StaticResource SectionLabel}"/>
                        <ComboBox ItemsSource="{Binding ImageFormatOptions}"
                                  SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Text="压缩质量"
                                   Foreground="{Binding IsQualityEnabled, Converter={StaticResource EnabledToBrush}}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,12,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1"
                                    Maximum="100"
                                    IsEnabled="{Binding IsQualityEnabled}"
                                    Value="{Binding Quality, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     IsEnabled="{Binding IsQualityEnabled}"
                                     Text="{Binding Quality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="54"
                                     Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock Text="数值越小文件越小，画质越低；JPG 与 WebP 有效"
                                   Style="{StaticResource MetaText}"
                                   Foreground="{Binding IsQualityEnabled, Converter={StaticResource EnabledToBrush}}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="PNG 为无损格式，画质与缩放功能不可用"
                                   Style="{StaticResource MetaText}"
                                   Foreground="{StaticResource Brush.Warning}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding IsQualityEnabled, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="缩放比例"
                                   Foreground="{Binding IsQualityEnabled, Converter={StaticResource EnabledToBrush}}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding ScaleOptions}"
                                  SelectedItem="{Binding SelectedScaleOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsQualityEnabled}"
                                  HorizontalAlignment="Left"
                                  Width="170"/>

                        <TextBlock Text="输出目录"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     Background="#FAFAFA"/>
                            <Button Grid.Column="1"
                                    Content="浏览…"
                                    Style="{StaticResource Button.Secondary}"
                                    Padding="10,5"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseOutputCommand}"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="添加图片"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding AddFilesCommand}"/>
                            <Button Grid.Column="2"
                                    Content="{Binding StartButtonText}"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding StartCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="格式说明"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource Brush.AccentSoft}"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedFormatName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Accent}"/>
                                <TextBlock Text="{Binding SelectedFormatSummary}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SelectedFormatDescription}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="压缩状态" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ActiveTaskName}"
                                   Style="{StaticResource BodyText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ActiveStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"/>
                        <Button Content="取消"
                                Style="{StaticResource Button.Danger}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
