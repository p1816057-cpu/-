<UserControl x:Class="AudioConverter.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:set="clr-namespace:AudioConverter.Modules.Settings">

    <UserControl.Resources>
        <Style x:Key="SettingsTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row"
                                    Background="Transparent"
                                    CornerRadius="7"
                                    Padding="10,7"
                                    Margin="1,1">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="14,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="设置"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Text="设置保存在本机；界面采用统一主题，Win7 / Win10 / Win11 均可使用"
                           Style="{StaticResource BodyText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 常驻操作栏：固定在设置页顶部，滚动右侧设置内容时不会消失 -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="10,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="遇到问题了？导出日志并联系管理员"
                            Style="{StaticResource Button.Ghost}"
                            Margin="0,0,10,0"
                            Command="{Binding ExportLogCommand}"/>
                    <Button Content="恢复默认"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ResetCommand}"/>
                    <Button Content="保存设置"
                            Style="{StaticResource Button.Primary}"
                            Margin="10,0,0,0"
                            IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分组导航 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <TreeView x:Name="SectionTree"
                          ItemsSource="{Binding NavGroups}"
                          SelectedItemChanged="OnSectionTreeSelectionChanged"
                          Background="Transparent"
                          BorderThickness="0">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type set:SettingsNavGroup}"
                                                  ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Margin="2,6,0,2"/>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type set:SettingsNavItem}">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       Margin="10,4,0,4"/>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <StaticResource ResourceKey="SettingsTreeItemStyle"/>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <!-- 右侧设置内容 -->
            <ScrollViewer Grid.Column="2"
                          x:Name="SettingsScroll"
                          ScrollChanged="OnSettingsScrollChanged"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- 常规 -->
                    <Border x:Name="SectionGeneral" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="音频默认" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="音频默认输出格式" Margin="0,14,0,6"/>
                            <ComboBox ItemsSource="{Binding FormatOptions}"
                                      SelectedItem="{Binding SelectedDefaultFormat, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Left"
                                      Width="180"/>
                        </StackPanel>
                    </Border>

                    <!-- 图片默认 -->
                    <Border x:Name="SectionImageDefault" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="图片默认" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="图片默认输出格式" Margin="0,14,0,6"/>
                            <ComboBox ItemsSource="{Binding ImageFormatOptions}"
                                      SelectedItem="{Binding SelectedImageDefaultFormat, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Left"
                                      Width="180"/>
                            <TextBlock Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Text="WebP 适合网页与照片压缩；JPG 兼容性最好；PNG 无损体积较大。"/>
                        </StackPanel>
                    </Border>

                    <!-- 音频输出 -->
                    <Border x:Name="SectionOutput" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="音频输出" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="音频转换默认输出位置" Margin="0,14,0,6"/>
                            <RadioButton Content="程序所在文件夹（自动新建「转换输出」子文件夹）"
                                         IsChecked="{Binding AudioOutputProgramFolder, Mode=TwoWay}"
                                         GroupName="AudioOutput"
                                         Margin="0,4,0,0"/>
                            <RadioButton Content="与源文件相同文件夹（自动新建「转换输出」子文件夹）"
                                         IsChecked="{Binding AudioOutputSourceFolder, Mode=TwoWay}"
                                         GroupName="AudioOutput"
                                         Margin="0,6,0,0"/>
                            <RadioButton Content="自定义固定文件夹"
                                         IsChecked="{Binding AudioOutputCustom, Mode=TwoWay}"
                                         GroupName="AudioOutput"
                                         Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="输出目录（自定义模式下可修改）" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         MaxLines="2"
                                         VerticalContentAlignment="Center"
                                         Visibility="{Binding AudioOutputCustom, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Text="{Binding AudioOutputDirectoryDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         MaxLines="2"
                                         VerticalContentAlignment="Center"
                                         Background="{StaticResource Brush.SurfaceAlt}"
                                         Foreground="{StaticResource Brush.TextSecondary}"
                                         ToolTip="{Binding AudioOutputDirectoryDisplay}"
                                         Visibility="{Binding AudioOutputCustom, Converter={StaticResource InverseBool}}"/>
                                <Button Grid.Column="1"
                                        Content="浏览…"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding BrowseOutputCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="前两种模式这里只显示实际会用到的目录（不可修改）；点「浏览…」会切换为自定义文件夹。程序目录不可写时（例如装在 C:\Program Files）自动改用源文件所在文件夹。"/>
                        </StackPanel>
                    </Border>

                    <!-- 图片输出 -->
                    <Border x:Name="SectionImageOutput" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="图片输出" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="图片转换、压缩默认输出位置" Margin="0,14,0,6"/>
                            <RadioButton Content="程序所在文件夹（自动新建「转换输出」子文件夹）"
                                         IsChecked="{Binding ImageOutputProgramFolder, Mode=TwoWay}"
                                         GroupName="ImageOutput"
                                         Margin="0,4,0,0"/>
                            <RadioButton Content="与源文件相同文件夹（自动新建「转换输出」子文件夹）"
                                         IsChecked="{Binding ImageOutputSourceFolder, Mode=TwoWay}"
                                         GroupName="ImageOutput"
                                         Margin="0,6,0,0"/>
                            <RadioButton Content="自定义固定文件夹"
                                         IsChecked="{Binding ImageOutputCustom, Mode=TwoWay}"
                                         GroupName="ImageOutput"
                                         Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="输出目录（自定义模式下可修改）" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ImageOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         MaxLines="2"
                                         VerticalContentAlignment="Center"
                                         Visibility="{Binding ImageOutputCustom, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Text="{Binding ImageOutputDirectoryDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         MaxLines="2"
                                         VerticalContentAlignment="Center"
                                         Background="{StaticResource Brush.SurfaceAlt}"
                                         Foreground="{StaticResource Brush.TextSecondary}"
                                         ToolTip="{Binding ImageOutputDirectoryDisplay}"
                                         Visibility="{Binding ImageOutputCustom, Converter={StaticResource InverseBool}}"/>
                                <Button Grid.Column="1"
                                        Content="浏览…"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding BrowseImageOutputCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="前两种模式这里只显示实际会用到的目录（不可修改）；点「浏览…」会切换为自定义文件夹。音频与图片互不影响。"/>
                        </StackPanel>
                    </Border>

                    <!-- 转换 -->
                    <Border x:Name="SectionConversion" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="转换" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="编码参数"
                                           Style="{StaticResource BodyText}"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="12,0,0,0"
                                           Text="MP3 = 320 kbps CBR；WAV = 16-bit PCM；FLAC = Compression Level 5。禁止自定义 FFmpeg 参数，以保证可靠性。"/>
                            </Grid>
                            <TextBlock Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Text="转换完成后保持原勾选状态；新添加文件默认不勾选。"/>
                        </StackPanel>
                    </Border>

                    <!-- 文件冲突 -->
                    <Border x:Name="SectionConflict" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="文件冲突" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="当输出目录已存在同名文件时："
                                       Style="{StaticResource BodyText}"
                                       Margin="0,12,0,4"/>
                            <RadioButton Content="自动重命名（推荐）：追加 (1)、(2)…，绝不覆盖源文件"
                                         IsChecked="{Binding Rename, Mode=TwoWay}"
                                         GroupName="Conflict"
                                         Margin="0,6,0,0"/>
                            <RadioButton Content="覆盖已有文件（源文件始终受保护，不会被覆盖）"
                                         IsChecked="{Binding Overwrite, Mode=TwoWay}"
                                         GroupName="Conflict"
                                         Margin="0,6,0,0"/>
                            <RadioButton Content="跳过：该文件不转换，并在列表中标记为“已跳过”"
                                         IsChecked="{Binding Skip, Mode=TwoWay}"
                                         GroupName="Conflict"
                                         Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 任务 -->
                    <Border x:Name="SectionTask" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="任务" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="多个文件按顺序逐个转换（一次一个），可在转换面板随时取消当前任务。"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <CheckBox Content="转换失败后自动重试"
                                      IsChecked="{Binding AutoRetry, Mode=TwoWay}"
                                      Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                                <TextBlock Text="最大重试次数"
                                           Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding RetryOptions}"
                                          SelectedItem="{Binding RetryLimit, Mode=TwoWay}"
                                          Width="70"
                                          Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 存储 -->
                    <Border x:Name="SectionStorage" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="存储" Style="{StaticResource CardTitle}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="日志目录" Margin="0,14,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LogDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Button.Secondary}"
                                        Padding="12,6" Margin="8,0,0,0" Command="{Binding BrowseLogCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="临时目录" Margin="0,14,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TempDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Button.Secondary}"
                                        Padding="12,6" Margin="8,0,0,0" Command="{Binding BrowseTempCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="FFmpeg 目录（留空 = 自动查找）" Margin="0,14,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding FfmpegDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Button.Secondary}"
                                        Padding="12,6" Margin="8,0,0,0" Command="{Binding BrowseFfmpegCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="自动查找顺序：此处指定的目录 → 程序目录\ffmpeg\bin → PATH。"/>
                            <Button Content="打开数据目录（设置 / 历史文件）"
                                    Style="{StaticResource Button.Ghost}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Command="{Binding OpenDataFolderCommand}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
