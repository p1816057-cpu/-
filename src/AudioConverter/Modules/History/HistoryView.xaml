<UserControl x:Class="AudioConverter.Modules.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:AudioConverter.Components">

    <Grid Margin="18,16,18,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="2,0,0,12">
            <StackPanel>
                <TextBlock Text="历史"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Text="最近 200 条转换记录，支持搜索、筛选与列排序"
                           Style="{StaticResource BodyText}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button Content="清空历史"
                        Style="{StaticResource Button.Secondary}"
                        Padding="12,6"
                        FontSize="12"
                        Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索与筛选 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0"
                             ToolTip="搜索文件名、输出路径或错误码"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="原格式"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding InputFormatOptions}"
                                  SelectedItem="{Binding SelectedInputFormat, Mode=TwoWay}"
                                  Width="96"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="转换后"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding OutputFormatOptions}"
                                  SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay}"
                                  Width="96"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Text="输入关键字，例如 test.mp3 或 MP3"
                               Style="{StaticResource MetaText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- 表格 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 空状态 -->
                    <components:EmptyState Grid.Row="1"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                           Title="没有符合条件的记录"
                                           Description="调整搜索条件，或完成一次转换后查看"
                                           Glyph="&#x21BA;"/>

                    <Grid Grid.Row="0" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="8"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Divider}"
                                BorderThickness="0,0,0,1"
                                Padding="10,6"/>

                        <Button x:Name="HeaderFile" Tag="文件"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="文件"/>
                        <Button x:Name="HeaderInput" Tag="原格式" Grid.Column="1"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="原格式"/>
                        <Button x:Name="HeaderOutput" Tag="转换后格式" Grid.Column="2"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="转换后"/>
                        <Button x:Name="HeaderResult" Tag="结果" Grid.Column="3"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="结果"/>
                        <Button x:Name="HeaderSize" Tag="输出大小" Grid.Column="4"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="大小"/>
                        <Button x:Name="HeaderDuration" Tag="耗时" Grid.Column="5"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="耗时"/>
                        <Button x:Name="HeaderTime" Tag="时间" Grid.Column="6"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="时间"/>
                        <Button x:Name="HeaderError" Tag="错误码/信息" Grid.Column="7"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="6,3" HorizontalContentAlignment="Left"
                                Click="OnSortClick" Content="错误"/>
                    </Grid>

                    <!-- 数据行 -->
                    <Grid Grid.Row="1" Margin="0,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="8"
                                                    BorderBrush="{StaticResource Brush.Divider}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,6"/>

                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Margin="10,4,6,4">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FileName}"/>
                                                <TextBlock Text="{Binding OutputPath}"
                                                           Style="{StaticResource MetaText}"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OutputPath}"/>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,2,0,0">
                                                    <Button Content="打开所在位置"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Foreground="{StaticResource Brush.Accent}"
                                                            Padding="4,1"
                                                            FontSize="11"
                                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding OutputPath}"/>
                                                    <Button Content="删除"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Foreground="{StaticResource Brush.Danger}"
                                                            Padding="4,1"
                                                            FontSize="11"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding InputFormat}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="2,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding OutputFormat}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="2,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="3"
                                                    Background="{Binding Result, Converter={StaticResource HistoryResultToBrush}}"
                                                    CornerRadius="5"
                                                    Padding="6,2"
                                                    Margin="0,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Result, Converter={StaticResource HistoryResultToText}}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Result, Converter={StaticResource HistoryResultToForeground}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding SizeBytes, Converter={StaticResource BytesToSize}}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="2,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding DurationSeconds, StringFormat={}{0:0.#}s}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="2,0"/>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="2,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                            <StackPanel Grid.Column="7"
                                                        VerticalAlignment="Center"
                                                        Margin="6,0">
                                                <TextBlock Text="{Binding ErrorCode}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Brush.Danger}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                    Style="{StaticResource MetaText}"
                                                    HorizontalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ErrorMessage}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
